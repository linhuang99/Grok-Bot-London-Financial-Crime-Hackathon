#!/usr/bin/env python3
"""Decide every screening hit in a data folder.

Usage: system/run <data folder> <output file>

Writes one JSON line per hit. Placeholder: answers REVIEW for every hit until
the real decision logic lands.
"""
import json
import os
import sys


def main():
    data_dir, out_path = sys.argv[1], sys.argv[2]
    with open(os.path.join(data_dir, "alerts.jsonl"), encoding="utf-8") as f:
        alerts = [json.loads(line) for line in f]
    with open(out_path, "w", encoding="utf-8") as out:
        for alert in alerts:
            for hit_id in alert["hit_ids"]:
                out.write(json.dumps({
                    "hit_id": hit_id,
                    "alert_id": alert["alert_id"],
                    "decision": "REVIEW",
                    "reason_code": "INSUFFICIENT_DATA",
                    "customer_record_id": None,
                    "reason": "Not yet assessed.",
                    "evidence": [],
                }) + "\n")


if __name__ == "__main__":
    main()
